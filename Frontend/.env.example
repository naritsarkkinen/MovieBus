# Copy this file to .env only if you need another API address.
# By default the frontend calls /api, and Vite forwards it to the backend
# on http://localhost:4000 (see vite.config.js).
# For a deployed backend, use the full address, for example:
# VITE_API_URL=https://<your-backend>.azurewebsites.net/api

# Optional XP leaderboard endpoint, relative to VITE_API_URL.
# Leave unset to display labelled demo scores.
# VITE_XP_LEADERBOARD_PATH=/leaderboards/xp
